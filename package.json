{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "node-pg-migrate up --envPath .env.local",
    "seed:demo": "node scripts/seed-demo.mjs",
    "migrate:down": "node-pg-migrate down --envPath .env.local",
    "migrate:create": "node-pg-migrate create -j sql",
    "docker:up": "docker compose --env-file .env.local up --build",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@types/pg": "^8.20.0",
    "lucide-react": "^1.22.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "plaid": "^42.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.8",
    "react-plaid-link": "^4.1.1",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "husky": "^9.1.7",
    "node-pg-migrate": "^9.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
