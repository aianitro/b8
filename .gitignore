# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# P1-10a: workspaces have their own, and a leading slash only matches the repo root.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# P1-10a: the build output moved to apps/web/.next. The rooted pattern above stopped matching
# it, and 3,317 build artifacts were staged once before this line existed.
apps/*/.next/
**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
apps/*/next-env.d.ts

# kept local — private job-search strategy notes
ROADMAP.md

# kept local — internal design working docs, not part of the shipped app
DASHBOARD-UX-REVIEW.md
ops/daily-job.log

# Duplicates the folder sync keeps creating ("route 2.ts"). They are byte-identical copies
# that were committed once by accident; under app/api each one is a second route file.
*[0-9].ts
*[0-9].tsx

# Expo (apps/mobile)
.expo/
apps/*/.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Database dumps, written on the server by scripts/backup.ts. Never in the repo, and named here
# so `git status` on the server is quiet and `git clean` can never reach them.
apps/backups/
backups/

# Deployer runtime state, created in the checkout on the server by ops/server/pull-deploy.sh.
.deploy.lock/
.deploy-last-said
